{
  "name": "credit-cards-india-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/prebuild.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen-types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ratchet": "node scripts/check-ratchet.mjs",
    "file-size": "node scripts/check-file-size.mjs",
    "a11y": "node scripts/a11y-smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "knip": "knip",
    "dup": "jscpd",
    "arch": "depcruise app lib components --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.4.2",
    "jscpd": "5.4.1",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "^15.0.3",
    "knip": "6.41.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
