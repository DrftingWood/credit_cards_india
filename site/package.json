{
  "name": "credit-cards-india-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/prebuild.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen-types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ratchet": "node scripts/check-ratchet.mjs",
    "file-size": "node scripts/check-file-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "knip": "knip",
    "dup": "jscpd",
    "arch": "depcruise app lib components --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "jscpd": "5.4.1",
    "json-schema-to-typescript": "^15.0.3",
    "knip": "6.41.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
