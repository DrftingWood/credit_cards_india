{
  "path": ["app", "lib", "components", "scripts"],
  "format": ["typescript", "tsx", "javascript"],
  "ignore": ["**/node_modules/**", "**/.next/**", "**/*.d.ts", "**/*.test.ts", "**/*.test.tsx", "lib/generated-types.ts"],
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "gitignore": true,
  "reporters": ["console", "json"],
  "output": ".reports/jscpd",
  "absolute": false
}
